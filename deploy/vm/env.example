# Copy to .env on every VM (same file everywhere) and fill in the addresses.
# All compose files in this directory read it.

# Image source: build locally (docker compose build) or pull from a registry.
REGISTRY=amaze-sms
TAG=signoff

# Private IPs of the sign-off VMs (see docs/signoff-5k.md for the layout).
KAFKA_1=10.0.0.11
KAFKA_2=10.0.0.12
KAFKA_3=10.0.0.13
DATA_1=10.0.0.21          # PostgreSQL primary + Redis
CH_1=10.0.0.31            # ClickHouse
APP_1=10.0.0.41
APP_2=10.0.0.42
SIM_1=10.0.0.51           # vendor simulators
MON_1=10.0.0.61           # Prometheus + Grafana

# Secrets: change all of these.
POSTGRES_PASSWORD=change-me
CLICKHOUSE_PASSWORD=change-me
SECRETS_KEY=generate-with-openssl-rand-hex-32
GRAFANA_ADMIN_PASSWORD=change-me

# Sizing knobs (defaults fit 8 vCPU / 32 GB data VMs).
PG_SHARED_BUFFERS=8GB
PG_MAX_CONNECTIONS=400
REDIS_MAXMEMORY=16gb
REDPANDA_SMP=6
REDPANDA_MEMORY=24G

# HLR provider for routes with hlr on (docs/phase3-network.md). Leave HLR_URL
# empty to run without HLR; MNP and number series still apply.
HLR_URL=
HLR_AUTH_HEADER=Authorization
HLR_AUTH_VALUE=
HLR_MCCMNC_PATH=
HLR_MCC_PATH=
HLR_MNC_PATH=
HLR_STATUS_PATH=
HLR_STATUS_OK=
HLR_STATUS_ABSENT=
HLR_STATUS_INVALID=

# Portal (admin-api serves it). Browsers sign in at this Keycloak URL with
# the public client amaze-portal; leave empty to use OIDC_ISSUER.
PORTAL_OIDC_ISSUER=

# Low-balance alerts (alerter): e-mail through any SMTP relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@example.com
SMTP_TLS=starttls
# SMS alerts are sent through the platform's own HTTP API as an alerts
# account; its DLT template must match ALERT_SMS_TEMPLATE (see docs/phase4-portals.md).
ALERT_SMS_URL=
ALERT_SMS_API_KEY=
ALERT_SMS_SENDER=
