# Rendered to alertmanager.yml by `scripts/signoff.sh render-monitoring`.
global:
  smtp_smarthost: '__SMTP_HOST__:__SMTP_PORT__'
  smtp_from: '__SMTP_FROM__'
  smtp_auth_username: '__SMTP_USER__'
  smtp_auth_password: '__SMTP_PASSWORD__'
  smtp_require_tls: __SMTP_REQUIRE_TLS__
route:
  receiver: ops
  group_by: [alertname, vendor, instance]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - matchers: [severity="critical"]
      receiver: ops
      repeat_interval: 1h
receivers:
  - name: ops
    email_configs:
      - to: '__ALERT_EMAIL_TO__'
        send_resolved: true
__WEBHOOK__
