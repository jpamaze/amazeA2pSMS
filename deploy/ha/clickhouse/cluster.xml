<!-- One shard, three replicas (CH_1..CH_3), with ClickHouse Keeper embedded
     in each server (quorum 2 of 3). Values come from the environment. -->
<clickhouse>
  <listen_host>0.0.0.0</listen_host>
  <interserver_http_host from_env="SELF"/>
  <macros>
    <shard>01</shard>
    <replica from_env="NODE_NAME"/>
  </macros>
  <keeper_server>
    <tcp_port>9181</tcp_port>
    <server_id from_env="KEEPER_ID"/>
    <log_storage_path>/var/lib/clickhouse/coordination/log</log_storage_path>
    <snapshot_storage_path>/var/lib/clickhouse/coordination/snapshots</snapshot_storage_path>
    <coordination_settings>
      <operation_timeout_ms>10000</operation_timeout_ms>
      <session_timeout_ms>30000</session_timeout_ms>
    </coordination_settings>
    <raft_configuration>
      <server><id>1</id><hostname from_env="CH_1"/><port>9234</port></server>
      <server><id>2</id><hostname from_env="CH_2"/><port>9234</port></server>
      <server><id>3</id><hostname from_env="CH_3"/><port>9234</port></server>
    </raft_configuration>
  </keeper_server>
  <zookeeper>
    <node><host from_env="CH_1"/><port>9181</port></node>
    <node><host from_env="CH_2"/><port>9181</port></node>
    <node><host from_env="CH_3"/><port>9181</port></node>
  </zookeeper>
  <distributed_ddl><path>/clickhouse/task_queue/ddl</path></distributed_ddl>
  <!-- Backups: BACKUP ... TO Disk('backups', ...) lands on the NFS share;
       TO S3(...) goes to object storage (see backup.sh). -->
  <storage_configuration>
    <disks><backups><type>local</type><path>/backup/clickhouse/</path></backups></disks>
  </storage_configuration>
  <backups>
    <allowed_disk>backups</allowed_disk>
    <allowed_path>/backup/clickhouse/</allowed_path>
  </backups>
</clickhouse>
