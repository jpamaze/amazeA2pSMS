# Production HA layout (docs/phase5-ha.md). Copy to deploy/ha/.env AND
# deploy/vm/.env on every VM (same content everywhere); the app, Kafka and
# monitoring compose files in deploy/vm read the same variables.

REGISTRY=amaze-sms
TAG=release

# --- Addresses (private network) ---
KAFKA_1=10.0.1.11
KAFKA_2=10.0.1.12
KAFKA_3=10.0.1.13
PG_1=10.0.1.21            # PostgreSQL + Patroni + etcd
PG_2=10.0.1.22
PG_3=10.0.1.23
REDIS_1=10.0.1.31         # Redis + Sentinel (REDIS_1 starts as primary)
REDIS_2=10.0.1.32
REDIS_3=10.0.1.33
CH_1=10.0.1.41            # ClickHouse + Keeper
CH_2=10.0.1.42
CH_3=10.0.1.43
APP_1=10.0.1.51           # every platform service
APP_2=10.0.1.52
APP_3=10.0.1.53
LB_1=10.0.1.61            # HAProxy + keepalived (skip with a cloud NLB)
LB_2=10.0.1.62
LB_VIP=10.0.1.60
LB_INTERFACE=eth0
MON_1=10.0.1.71
# Single-node names used by deploy/vm files; point them at the first nodes.
DATA_1=10.0.1.21
SIM_1=10.0.1.81

# --- What the platform services connect to ---
# PostgreSQL: all three nodes; the driver picks the writable one and moves
# with a failover.
POSTGRES_URL=postgres://sms:change-me@10.0.1.21:5432,10.0.1.22:5432,10.0.1.23:5432/sms?sslmode=disable&target_session_attrs=read-write&connect_timeout=3
# Redis: the three Sentinels and the master name they watch.
REDIS_ADDRS=10.0.1.31:26379,10.0.1.32:26379,10.0.1.33:26379
REDIS_SENTINEL_MASTER=amaze
# ClickHouse: all three replicas.
CLICKHOUSE_URL=http://10.0.1.41:8123,http://10.0.1.42:8123,http://10.0.1.43:8123

# --- Secrets: change all of these ---
POSTGRES_PASSWORD=change-me           # application role sms (also in POSTGRES_URL)
PG_SUPERUSER_PASSWORD=change-me
PG_REPLICATION_PASSWORD=change-me
REDIS_PASSWORD=change-me
CLICKHOUSE_PASSWORD=change-me
SECRETS_KEY=generate-with-openssl-rand-hex-32
BACKUP_CIPHER_PASS=generate-with-openssl-rand-base64-48   # keep a copy outside the platform
LB_VRRP_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me

# --- Backups ---
# S3-compatible object storage (AWS S3, GCS interoperability, MinIO, ...).
S3_ENDPOINT=s3.ap-south-1.amazonaws.com
S3_PORT=443
S3_REGION=ap-south-1
S3_BUCKET=amaze-sms-backups
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_URI_STYLE=host                 # path for MinIO and most self-hosted stores
# NFS share (or any disk on another machine), mounted at this path on the
# PostgreSQL, Redis and ClickHouse VMs.
BACKUP_NFS_PATH=/mnt/backup
BACKUP_RETENTION_FULL_S3=4        # weekly fulls kept (PostgreSQL)
BACKUP_RETENTION_FULL_NFS=2
BACKUP_KEEP_DAYS=35               # ClickHouse and Redis copies on NFS

# --- Sizing (defaults fit the blueprint's servers) ---
PG_SHARED_BUFFERS=16GB
PG_MAX_CONNECTIONS=400
REDIS_MAXMEMORY=24gb
REDPANDA_SMP=6
REDPANDA_MEMORY=24G
